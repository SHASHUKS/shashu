{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "excludeFiles": [
    "venv/**",
    ".venv/**",
    "__pycache__/**",
    "*.pyc",
    ".git/**",
    "local_test_data/**"
  ]
}